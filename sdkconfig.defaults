# XTEINK X4 Pro: ESP32-S3, 16 MB flash, 8 MB octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Every wake from deep sleep is a fresh start: skip the PSRAM test (about
# 8 MB written and read back) and the app image check on those starts.
# Power-on starts and updates still check the image.
# CONFIG_SPIRAM_MEMTEST is not set
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
# Only small blocks (under 4 KB) prefer internal RAM; the app's buffers go to
# PSRAM. Internal RAM is kept for Wi-Fi, DMA and task stacks: with the 16 KB
# default the app's font, cover and book buffers filled it before Wi-Fi
# started (docs/checkup.md).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Speed: run fast when busy, let power management scale down when idle.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Battery: dynamic frequency scaling and automatic light sleep when idle.
# The board arms the buttons and the touch line as wake-ups just before each
# light sleep (the callbacks), and the USB log keeps the chip awake while a
# computer is connected (it cannot work through light sleep).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# Logs and flashing over the built-in USB serial/JTAG port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The app runs on the main task. Decoding a PNG cover alone takes about
# 9 KB of stack (stb_image), so 8 KB overflowed; see docs/checkup.md.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# A crash leaves a core dump in the "coredump" partition for
# `idf.py coredump-info` (it already exists in partitions.csv).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# SD card: long file names in UTF-8, so book files keep their real names.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Wi-Fi book upload: radio buffers in PSRAM where possible, and room for
# long book names and browser headers in requests.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# Software updates: a new version must prove it starts before it is kept.
# If it fails to start, the next boot goes back to the previous version.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
