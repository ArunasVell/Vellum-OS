# XTEINK X4 Pro: ESP32-S3, 16 MB flash, 8 MB octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Speed: run fast when busy, let power management scale down when idle.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Battery: dynamic frequency scaling and automatic light sleep when idle.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Logs and flashing over the built-in USB serial/JTAG port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Room for text layout on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
